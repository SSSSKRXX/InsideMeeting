{
  "name": "inside-meeting-tray",
  "version": "0.1.0",
  "private": true,
  "description": "InsideMeeting 服务端菜单栏控制器",
  "main": "main.js",
  "author": "SSSSKRXX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.inside.meeting.tray",
    "productName": "InsideMeeting 服务",
    "directories": { "output": "release" },
    "files": ["main.js", "assets/**"],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
