{
  "name": "inside-meeting-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "InsideMeeting 桌面端：可作为服务器运行，也可只作为参会客户端",
  "main": "main.js",
  "author": "SSSSKRXX",
  "license": "MIT",
  "scripts": {
    "prepare-bundle": "node scripts/prepare.js",
    "start": "electron .",
    "dist": "npm run prepare-bundle && electron-builder",
    "dist:mac": "npm run prepare-bundle && electron-builder --mac",
    "dist:win": "npm run prepare-bundle && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.inside.meeting",
    "productName": "InsideMeeting",
    "directories": { "output": "release" },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "cert.js",
      "server-manager.js",
      "setup.html",
      "server.html",
      "assets/**",
      "bundled/**",
      "node_modules/**"
    ],
    "artifactName": "InsideMeeting-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icon.png",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "extendInfo": {
        "NSCameraUsageDescription": "会议需要使用摄像头",
        "NSMicrophoneUsageDescription": "会议需要使用麦克风，并用于生成会议纪要",
        "NSScreenCaptureUsageDescription": "屏幕共享需要录制屏幕内容"
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "InsideMeeting"
    }
  }
}
