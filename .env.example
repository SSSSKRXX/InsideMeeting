# 复制成 .env 后按需修改：cp .env.example .env

# ---------- 服务 ----------
PORT=8443
HOST=0.0.0.0
TLS_ENABLED=true
# 证书路径默认 ./certs/cert.pem 与 ./certs/key.pem，用 scripts/gen-cert.sh 生成
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem

DATA_DIR=./data

# 入会口令（留空表示不校验）
JOIN_PASSWORD=
# 删除录制等管理操作的口令（留空表示不校验）
ADMIN_TOKEN=

# ---------- 录制 ----------
# 每 60 分钟切一个文件
SEGMENT_MINUTES=60
# 客户端每 5 秒上传一个分片（越小越不容易丢，越大越省请求数）
CHUNK_SECONDS=5
MAX_UPLOAD_MB=64

# ---------- 组网 ----------
# tailscale = 所有人在同一个 Tailscale 虚拟内网，peer 之间直连，不需要 STUN/TURN
# lan       = 同一个物理局域网，同样不需要 STUN/TURN
# public    = 走公网，需要 STUN，跨 NAT 还需要 TURN
NETWORK_MODE=tailscale

# 下面这些只有 NETWORK_MODE=public 时才生效
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:你的公网IP:3478?transport=udp,turn:你的公网IP:3478?transport=tcp
# TURN_USERNAME=inside
# TURN_PASSWORD=改成一个长随机串

# ---------- 会中实时纪要 ----------
LIVE_ENABLED=true
# 每 15 秒出一个可独立解码的小片送去转写
LIVE_CHUNK_SECONDS=15
# 每 60 秒重写一次滚动摘要
LIVE_SUMMARY_SECONDS=60
# 距上次摘要新增字数不足这个值就跳过，避免没人说话时白烧额度
LIVE_MIN_CHARS=60
# 实时片段默认用完即删；调成 true 可以保留下来排查问题
LIVE_KEEP_AUDIO=false

# ---------- 语音转写（OpenAI 兼容接口）----------
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
# zh / en / auto
ASR_LANGUAGE=zh
ASR_CONCURRENCY=3

# ---------- 会议纪要（OpenAI 兼容接口）----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CHUNK_CHARS=24000

# ---------- ffmpeg ----------
# macOS: brew install ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
