# 复制成 .env 后按需修改：cp .env.example .env

# ---------- 服务 ----------
PORT=8443
HOST=0.0.0.0
TLS_ENABLED=true
# 证书路径默认 ./certs/cert.pem 与 ./certs/key.pem，用 scripts/gen-cert.sh 生成
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem

DATA_DIR=./data

# 全局入会口令：所有房间通用的第一道门（留空表示不校验）
# 房间级密码、等候室、锁定会议由主持人在会中设置，存在 data/rooms.json
JOIN_PASSWORD=
# 删除录制等管理操作的口令（留空表示不校验）
ADMIN_TOKEN=

# ---------- 纪要自动推送 ----------
# 会后纪要生成完自动推送。配了哪个渠道就发哪个，都没配就跳过。
NOTIFY_ENABLED=true
# 推送消息里「查看完整纪要」按钮指向的地址
# PUBLIC_BASE_URL=https://macmini.你的tailnet.ts.net:8443

# 企业微信群机器人：群设置 → 群机器人 → 添加 → 复制 Webhook 地址
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 飞书群机器人：群设置 → 群机器人 → 添加自定义机器人
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 如果机器人开了「签名校验」，把密钥填这里；没开就留空
# FEISHU_SECRET=

# 邮件（需要先装依赖：npm --workspace server install nodemailer）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@qq.com
# SMTP_PASS=授权码（不是登录密码）
# SMTP_FROM=InsideMeeting <you@qq.com>
# MAIL_TO=a@company.com,b@company.com
# 是否把纪要和逐字稿作为附件一起发
MAIL_ATTACH=true

# ---------- 录制 ----------
# 每 60 分钟切一个文件
SEGMENT_MINUTES=60
# 客户端每 5 秒上传一个分片（越小越不容易丢，越大越省请求数）
CHUNK_SECONDS=5
MAX_UPLOAD_MB=64

# ---------- 组网 ----------
# tailscale = 所有人在同一个 Tailscale 虚拟内网，peer 之间直连，不需要 STUN/TURN
# lan       = 同一个物理局域网，同样不需要 STUN/TURN
# public    = 走公网，需要 STUN，跨 NAT 还需要 TURN
NETWORK_MODE=tailscale

# 下面这些只有 NETWORK_MODE=public 时才生效
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:你的公网IP:3478?transport=udp,turn:你的公网IP:3478?transport=tcp
# TURN_USERNAME=inside
# TURN_PASSWORD=改成一个长随机串

# Cloudflare Realtime TURN：给「参会者装不了 Tailscale」的场景用。
# 它不接受静态用户名密码 —— 在 Cloudflare 后台建一个 TURN Key，填下面两项，
# 服务端会拿它定时换取带有效期的临时凭证。Key 只留在服务端，不会下发到浏览器。
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# 凭证有效期（秒），要覆盖得住最长的一场会
CF_TURN_TTL=86400

# ---------- 会中实时纪要 ----------
LIVE_ENABLED=true
# 每 15 秒出一个可独立解码的小片送去转写
LIVE_CHUNK_SECONDS=15
# 每 60 秒重写一次滚动摘要
LIVE_SUMMARY_SECONDS=60
# 距上次摘要新增字数不足这个值就跳过，避免没人说话时白烧额度
LIVE_MIN_CHARS=60
# 实时片段默认用完即删；调成 true 可以保留下来排查问题
LIVE_KEEP_AUDIO=false

# ---------- 语音转写 ----------
# 接口类型：auto 自动判断 / openai OpenAI 兼容 / mimo 小米 MiMo
# 小米的 ASR 走 chat/completions 而不是 audio/transcriptions，两种接口不通用，
# 填错会报 404。auto 会按地址和模型名自动判断，一般不用改。
ASR_PROVIDER=auto

# OpenAI / 硅基流动 / 通义 / 自建 faster-whisper-server:
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
# 小米 MiMo:
# ASR_BASE_URL=https://api.xiaomimimo.com/v1
# ASR_MODEL=mimo-v2.5-asr

ASR_API_KEY=
# zh / en / auto
ASR_LANGUAGE=zh
ASR_CONCURRENCY=3

# ---------- 会议纪要（OpenAI 兼容接口）----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CHUNK_CHARS=24000

# ---------- ffmpeg ----------
# macOS: brew install ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- 会议记录访问控制 ----------
# 查看历史录音与纪要的口令。留空表示任何能访问服务的人都能查看全部历史记录。
# 注意：这三道口令各管一件事——入会、看历史、进管理后台。
# 也可以起服务后在管理后台的「设置」页里改，不用动这个文件。
ARCHIVE_PASSWORD=
